PUBLIC_BASE_URL=https://notify.novopacky.com
NTFY_BASE_URL=http://ntfy:80
NTFY_TOKEN=tk_example_replace_me
NTFY_USERNAME=
NTFY_PASSWORD=
CHANNEL_TOPICS_JSON={"personal":"replace-with-random-topic","urgent":"replace-with-random-topic","system":"replace-with-random-topic"}
REST_API_KEYS_JSON={"automation":"replace-with-a-long-random-key"}

# Personal ChatGPT connector: set all three values below.
MCP_ENABLED=false
OAUTH_SELF_HOSTED=false
OAUTH_LOGIN_PASSWORD=replace-with-at-least-20-random-characters

# Only needed when OAUTH_SELF_HOSTED=false.
OAUTH_ISSUER=https://YOUR_TENANT.example.com/
OAUTH_AUDIENCE=notification-gateway
OAUTH_JWKS_URL=https://YOUR_TENANT.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPES=notifications:write
